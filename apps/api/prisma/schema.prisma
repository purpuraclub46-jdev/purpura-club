datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// IDENTITY
// ─────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  password     String
  firstName    String
  lastName     String
  role         Role     @default(USER)
  refreshToken String?

  // Referido: quién invitó a este usuario. Si se llena al registro,
  // el primer pedido elegible recompensa al referrer.
  referredByUserId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries            RaffleEntry[]
  wonRaffle          Raffle[]            @relation("RaffleWinner")
  orders             Order[]
  inventoryMovements InventoryMovement[]
  inventoryTransfers InventoryTransfer[]

  membership      Membership?
  benefitLogs     MembershipBenefitLog[]
  referralsMade   Referral[]              @relation("ReferralFrom")
  referralReceived Referral?              @relation("ReferralTo")

  @@index([email])
  @@index([referredByUserId])
  @@map("users")
}

// ─────────────────────────────────────────────
// RAFFLES (existing — untouched)
// ─────────────────────────────────────────────

enum RaffleStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum RaffleVisibility {
  PUBLIC
  PRIVATE
}

enum EntryType {
  PURCHASE_REWARD
  DIRECT_PURCHASE
  REFERRAL
  BONUS
}

enum EntryStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  WINNER
}

enum PaymentMethod {
  YAPE
  FREE
  MERCADOPAGO
}

model Raffle {
  id                String           @id @default(uuid()) @db.Uuid
  title             String
  slug              String           @unique
  description       String           @db.Text
  bannerImage       String?
  prizeImage        String?
  countdown         DateTime?
  ticketPrice       Decimal          @db.Decimal(10, 2)
  memberTicketPrice Decimal          @db.Decimal(10, 2)
  totalTickets      Int
  soldTickets       Int              @default(0)
  status            RaffleStatus     @default(DRAFT)
  visibility        RaffleVisibility @default(PUBLIC)
  winnerUserId      String?          @db.Uuid
  startDate         DateTime
  endDate           DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  winner  User?         @relation("RaffleWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  entries RaffleEntry[]

  @@index([status, visibility])
  @@index([startDate])
  @@map("raffles")
}

model RaffleEntry {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  raffleId         String         @db.Uuid
  ticketNumber     Int
  type             EntryType      @default(DIRECT_PURCHASE)
  status           EntryStatus    @default(PAID)
  paymentMethod    PaymentMethod?
  paymentReference String?
  orderId          String?        @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([raffleId, ticketNumber])
  @@index([userId, status])
  @@index([raffleId, status])
  @@index([raffleId, type])
  @@index([orderId])
  @@map("raffle_entries")
}

// ─────────────────────────────────────────────
// ECOMMERCE — CATALOG
// ─────────────────────────────────────────────

enum CategoryGroup {
  JOYERIA
  PERFUMES
  ACCESORIOS
}

model Category {
  id       String        @id @default(uuid()) @db.Uuid
  name     String
  slug     String        @unique
  image    String?
  group    CategoryGroup @default(JOYERIA)
  order    Int           @default(0)
  active   Boolean       @default(true)
  parentId String?       @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products ProductCategory[]

  @@index([group, active])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  description String? @db.Text
  sku         String  @unique
  barcode     String? @unique

  // Precio normal (precio público base).
  price Decimal @db.Decimal(10, 2)
  // Costo interno (no público).
  cost  Decimal @db.Decimal(10, 2) @default(0)

  // Configuración de oferta dinámica. El precio de oferta y el precio miembro
  // se computan al vuelo a partir de estos campos.
  discountPercentage Decimal?  @db.Decimal(5, 2)
  discountActive     Boolean   @default(false)
  discountStartsAt   DateTime?
  discountEndsAt     DateTime?

  featured Boolean @default(false)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images        ProductImage[]
  categories    ProductCategory[]
  variants      ProductVariant[]
  availability  ProductAvailability[]
  stock         InventoryStock[]
  movements     InventoryMovement[]
  transferItems InventoryTransferItem[]
  orderItems    OrderItem[]

  @@index([active, featured])
  @@index([sku])
  @@map("products")
}

model ProductAvailability {
  id                  String  @id @default(uuid()) @db.Uuid
  productId           String  @db.Uuid
  inventoryLocationId String  @db.Uuid
  active              Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [inventoryLocationId], references: [id], onDelete: Cascade)

  @@unique([productId, inventoryLocationId])
  @@index([inventoryLocationId, active])
  @@index([productId, active])
  @@map("product_availability")
}

model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  url       String
  order     Int    @default(0)

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, order])
  @@map("product_images")
}

model ProductCategory {
  productId  String @db.Uuid
  categoryId String @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  name      String
  value     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name, value])
  @@index([productId])
  @@map("product_variants")
}

// ─────────────────────────────────────────────
// INVENTORY — ENTERPRISE MULTI-LOCATION
// ─────────────────────────────────────────────

enum InventoryLocationType {
  ECOMMERCE
  SUCURSAL
  ALMACEN
}

model InventoryLocation {
  id      String                @id @default(uuid()) @db.Uuid
  name    String
  slug    String                @unique
  type    InventoryLocationType
  address String?
  phone   String?
  active  Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock         InventoryStock[]
  movements     InventoryMovement[]
  orders        Order[]
  availability  ProductAvailability[]
  transfersFrom InventoryTransfer[] @relation("TransferFromLocation")
  transfersTo   InventoryTransfer[] @relation("TransferToLocation")

  @@index([active, type])
  @@map("inventory_locations")
}

model InventoryStock {
  id                  String @id @default(uuid()) @db.Uuid
  inventoryLocationId String @db.Uuid
  productId           String @db.Uuid
  stock               Int    @default(0)
  reservedStock       Int    @default(0)
  minimumStock        Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location InventoryLocation @relation(fields: [inventoryLocationId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([inventoryLocationId, productId])
  @@index([productId])
  @@map("inventory_stock")
}

enum InventoryMovementType {
  SALE
  RESTOCK
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  LOSS
  RESERVATION
}

model InventoryMovement {
  id                  String                @id @default(uuid()) @db.Uuid
  inventoryLocationId String                @db.Uuid
  productId           String                @db.Uuid
  quantity            Int
  type                InventoryMovementType
  reason              String?
  createdByUserId     String?               @db.Uuid
  transferId          String?               @db.Uuid

  createdAt DateTime @default(now())

  location      InventoryLocation  @relation(fields: [inventoryLocationId], references: [id], onDelete: Cascade)
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdByUser User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  transfer      InventoryTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@index([inventoryLocationId, createdAt])
  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([transferId])
  @@map("inventory_movements")
}

enum InventoryTransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model InventoryTransfer {
  id              String                  @id @default(uuid()) @db.Uuid
  number          String                  @unique
  fromLocationId  String                  @db.Uuid
  toLocationId    String                  @db.Uuid
  status          InventoryTransferStatus @default(PENDING)
  notes           String?
  createdByUserId String?                 @db.Uuid

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  fromLocation  InventoryLocation       @relation("TransferFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation    InventoryLocation       @relation("TransferToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  createdByUser User?                   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items         InventoryTransferItem[]
  movements     InventoryMovement[]

  @@index([status, createdAt])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id         String @id @default(uuid()) @db.Uuid
  transferId String @db.Uuid
  productId  String @db.Uuid
  quantity   Int

  createdAt DateTime @default(now())

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([transferId, productId])
  @@index([productId])
  @@map("inventory_transfer_items")
}

// ─────────────────────────────────────────────
// ECOMMERCE — ORDERS
// ─────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum OrderPaymentMethod {
  MERCADOPAGO
  YAPE
  CASH
  CARD
}

model Order {
  id                  String             @id @default(uuid()) @db.Uuid
  number              String             @unique
  userId              String?            @db.Uuid
  inventoryLocationId String?            @db.Uuid
  subtotal            Decimal            @db.Decimal(10, 2)
  discount            Decimal            @db.Decimal(10, 2) @default(0)
  total               Decimal            @db.Decimal(10, 2)
  paymentMethod       OrderPaymentMethod
  status              OrderStatus        @default(PENDING)
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  location      InventoryLocation? @relation(fields: [inventoryLocationId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  raffleEntries RaffleEntry[]
  benefitLogs   MembershipBenefitLog[]

  @@index([userId, status])
  @@index([inventoryLocationId, status])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─────────────────────────────────────────────
// PÚRPURA CLUB — MEMBERSHIP ENGINE
// ─────────────────────────────────────────────

model Membership {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  active         Boolean   @default(true)
  startedAt      DateTime  @default(now())
  expiresAt      DateTime
  lastPurchaseAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([active, expiresAt])
  @@index([expiresAt])
  @@map("memberships")
}

enum MembershipBenefitType {
  DISCOUNT
  RAFFLE_ENTRY
  REFERRAL_BONUS
}

model MembershipBenefitLog {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @db.Uuid
  orderId     String?               @db.Uuid
  type        MembershipBenefitType
  description String
  amount      Decimal?              @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([orderId])
  @@map("membership_benefit_logs")
}

model Referral {
  id              String  @id @default(uuid()) @db.Uuid
  referrerUserId  String  @db.Uuid
  referredUserId  String  @unique @db.Uuid
  rewarded        Boolean @default(false)
  rewardedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrer User @relation("ReferralFrom", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralTo", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId, rewarded])
  @@map("referrals")
}

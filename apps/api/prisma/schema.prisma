datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// IDENTITY
// ─────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  password     String
  firstName    String
  lastName     String
  // Nivel de acceso legacy/coarse-grained (USER/ADMIN/SUPER_ADMIN).
  // El RBAC dinámico (AppRole + Permission) es la fuente de verdad para
  // permisos efectivos; este campo solo se conserva por compatibilidad
  // con el guard de roles existente y como sello rápido de elegibilidad
  // administrativa para JWTs.
  role         Role    @default(USER)
  refreshToken String?

  // Referido: quién invitó a este usuario. Si se llena al registro,
  // el primer pedido elegible recompensa al referrer.
  referredByUserId String? @db.Uuid

  // F2.7-C — Código único, permanente e inmutable para compartir referidos.
  // Formato: PCLUB-XXXXXX (6 chars del alfabeto sin ambigüedad). Generado
  // atómicamente en register/backfill. NUNCA se regenera ni se edita desde
  // Admin. Nullable solo durante la ventana de migración + backfill; una
  // vez ejecutado el backfill, todos los users tienen código.
  referralCode String? @unique

  // DNI/documento de identidad — requerido para la entrega de premios.
  // Opcional para no romper usuarios pre-existentes.
  dni String? @unique

  // RBAC enterprise: ubicación asignada (sucursal/almacén/ecommerce).
  // Null = sin restricción de sucursal (SUPER_ADMIN típicamente).
  inventoryLocationId String? @db.Uuid

  // Activación de la cuenta. Inactivo = bloqueado para login.
  active Boolean @default(true)

  // Último login exitoso (auditoría).
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryLocation InventoryLocation? @relation("UserAssignedLocation", fields: [inventoryLocationId], references: [id], onDelete: SetNull)

  entries            RaffleEntry[]
  wonRaffle          Raffle[]            @relation("RaffleWinner")
  wonPrizes          RafflePrize[]       @relation("PrizeWinner")
  orders             Order[]
  inventoryMovements InventoryMovement[]
  inventoryTransfers InventoryTransfer[]

  membership            Membership?
  benefitLogs           MembershipBenefitLog[]
  membershipNotifications MembershipNotificationLog[]
  referralsMade         Referral[]             @relation("ReferralFrom")
  referralReceived      Referral?              @relation("ReferralTo")

  // RBAC dinámico
  roles             UserRole[]
  customPermissions UserPermission[]

  // CRM
  customerProfile Customer? @relation("UserCustomerProfile")

  // POS
  openedCashSessions   POSCashSession[]  @relation("CashSessionOpenedBy")
  closedCashSessions   POSCashSession[]  @relation("CashSessionClosedBy")
  createdCashMovements POSCashMovement[] @relation("CashMovementCreatedBy")
  createdCreditNotes   POSCreditNote[]   @relation("CreditNoteCreatedBy")

  @@index([email])
  @@index([referredByUserId])
  @@index([inventoryLocationId])
  @@index([active])
  @@map("users")
}

// ─────────────────────────────────────────────
// RBAC ENTERPRISE — Roles, permisos, asignaciones
// ─────────────────────────────────────────────

model AppRole {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  description String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions AppRolePermission[]
  users       UserRole[]

  @@index([active])
  @@map("app_roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  name        String
  description String?
  module      String

  createdAt DateTime @default(now())

  roles AppRolePermission[]
  users UserPermission[]

  @@index([module])
  @@map("permissions")
}

model AppRolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  createdAt DateTime @default(now())

  role       AppRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("app_role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  createdAt DateTime @default(now())

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// Override puntual de un permiso para un usuario (allow o deny explícito).
// allowed=true => fuerza el permiso aunque su rol no lo tenga.
// allowed=false => revoca el permiso aunque su rol lo otorgue.
model UserPermission {
  userId       String  @db.Uuid
  permissionId String  @db.Uuid
  allowed      Boolean @default(true)

  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@map("user_permissions")
}

// ─────────────────────────────────────────────
// RAFFLES (existing — untouched)
// ─────────────────────────────────────────────

enum RaffleStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum RaffleVisibility {
  PUBLIC
  PRIVATE
}

enum EntryType {
  PURCHASE_REWARD
  DIRECT_PURCHASE
  REFERRAL
  BONUS
}

enum EntryStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  WINNER
}

enum PaymentMethod {
  YAPE
  FREE
  MERCADOPAGO
}

model Raffle {
  id                String           @id @default(uuid()) @db.Uuid
  title             String
  slug              String           @unique
  description       String           @db.Text
  bannerImage       String?
  prizeImage        String?
  countdown         DateTime?
  ticketPrice       Decimal          @db.Decimal(10, 2)
  memberTicketPrice Decimal          @db.Decimal(10, 2)
  totalTickets      Int
  soldTickets       Int              @default(0)
  status            RaffleStatus     @default(DRAFT)
  visibility        RaffleVisibility @default(PUBLIC)
  winnerUserId      String?          @db.Uuid
  startDate         DateTime
  endDate           DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  winner  User?         @relation("RaffleWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  entries RaffleEntry[]
  prizes  RafflePrize[]

  @@index([status, visibility])
  @@index([startDate])
  @@map("raffles")
}

// Cada sorteo puede tener N premios (1° iPhone, 2° Perfume, 3° Collar...).
// El ganador se asigna manualmente con el número de ticket exportado en Excel.
// publishedAt vacío = ya hay ganador interno, pero NO publicado aún.
model RafflePrize {
  id          String  @id @default(uuid()) @db.Uuid
  raffleId    String  @db.Uuid
  title       String
  description String? @db.Text
  image       String?
  position    Int

  winnerUserId       String? @db.Uuid
  winnerEntryId      String? @unique @db.Uuid
  winnerTicketNumber Int?

  winnerPublished    Boolean   @default(false)
  winnerPhoto        String?
  winnerVideo        String?
  winnerAnnouncement String?   @db.Text
  publishedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  raffle      Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  winnerUser  User?        @relation("PrizeWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  winnerEntry RaffleEntry? @relation("PrizeWinningEntry", fields: [winnerEntryId], references: [id], onDelete: SetNull)

  @@unique([raffleId, position])
  @@index([raffleId, winnerPublished])
  @@index([winnerUserId])
  @@map("raffle_prizes")
}

model RaffleEntry {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  raffleId         String         @db.Uuid
  ticketNumber     Int
  type             EntryType      @default(DIRECT_PURCHASE)
  status           EntryStatus    @default(PAID)
  paymentMethod    PaymentMethod?
  paymentReference String?
  orderId          String?        @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  raffle   Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  order    Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  wonPrize RafflePrize? @relation("PrizeWinningEntry")

  @@unique([raffleId, ticketNumber])
  @@index([userId, status])
  @@index([raffleId, status])
  @@index([raffleId, type])
  @@index([orderId])
  @@map("raffle_entries")
}

// ─────────────────────────────────────────────
// ECOMMERCE — CATALOG
// ─────────────────────────────────────────────

enum CategoryGroup {
  JOYERIA
  PERFUMES
  ACCESORIOS
}

model Category {
  id       String        @id @default(uuid()) @db.Uuid
  name     String
  slug     String        @unique
  image    String?
  group    CategoryGroup @default(JOYERIA)
  order    Int           @default(0)
  active   Boolean       @default(true)
  parentId String?       @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]        @relation("CategoryHierarchy")
  products ProductCategory[]

  @@index([group, active])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  description String? @db.Text
  sku         String  @unique
  barcode     String? @unique

  // Precio normal (precio público base).
  price Decimal @db.Decimal(10, 2)
  // Costo interno (no público).
  cost  Decimal @default(0) @db.Decimal(10, 2)

  // Configuración de oferta dinámica. El precio de oferta y el precio miembro
  // se computan al vuelo a partir de estos campos.
  discountPercentage Decimal?  @db.Decimal(5, 2)
  discountActive     Boolean   @default(false)
  discountStartsAt   DateTime?
  discountEndsAt     DateTime?

  featured Boolean @default(false)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images          ProductImage[]
  categories      ProductCategory[]
  variants        ProductVariant[]
  availability    ProductAvailability[]
  stock           InventoryStock[]
  movements       InventoryMovement[]
  transferItems   InventoryTransferItem[]
  orderItems      OrderItem[]
  creditNoteItems POSCreditNoteItem[]

  @@index([active, featured])
  @@index([sku])
  @@map("products")
}

model ProductAvailability {
  id                  String  @id @default(uuid()) @db.Uuid
  productId           String  @db.Uuid
  inventoryLocationId String  @db.Uuid
  active              Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [inventoryLocationId], references: [id], onDelete: Cascade)

  @@unique([productId, inventoryLocationId])
  @@index([inventoryLocationId, active])
  @@index([productId, active])
  @@map("product_availability")
}

model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  url       String
  order     Int    @default(0)

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, order])
  @@map("product_images")
}

model ProductCategory {
  productId  String @db.Uuid
  categoryId String @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  name      String
  value     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name, value])
  @@index([productId])
  @@map("product_variants")
}

// ─────────────────────────────────────────────
// INVENTORY — ENTERPRISE MULTI-LOCATION
// ─────────────────────────────────────────────

enum InventoryLocationType {
  ECOMMERCE
  SUCURSAL
  ALMACEN
}

model InventoryLocation {
  id      String                @id @default(uuid()) @db.Uuid
  name    String
  slug    String                @unique
  type    InventoryLocationType
  address String?
  phone   String?
  active  Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock            InventoryStock[]
  movements        InventoryMovement[]
  orders           Order[]
  availability     ProductAvailability[]
  transfersFrom    InventoryTransfer[]   @relation("TransferFromLocation")
  transfersTo      InventoryTransfer[]   @relation("TransferToLocation")
  assignedUsers    User[]                @relation("UserAssignedLocation")
  primaryCustomers Customer[]            @relation("CustomerPrimaryLocation")
  cashRegisters    POSCashRegister[]     @relation("LocationCashRegisters")
  receiptSeries    ReceiptSeries[]       @relation("LocationReceiptSeries")
  creditNotes      POSCreditNote[]       @relation("LocationCreditNotes")

  @@index([active, type])
  @@map("inventory_locations")
}

model InventoryStock {
  id                  String @id @default(uuid()) @db.Uuid
  inventoryLocationId String @db.Uuid
  productId           String @db.Uuid
  stock               Int    @default(0)
  reservedStock       Int    @default(0)
  minimumStock        Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location InventoryLocation @relation(fields: [inventoryLocationId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([inventoryLocationId, productId])
  @@index([productId])
  @@map("inventory_stock")
}

enum InventoryMovementType {
  SALE
  RESTOCK
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  LOSS
  RESERVATION
}

model InventoryMovement {
  id                  String                @id @default(uuid()) @db.Uuid
  inventoryLocationId String                @db.Uuid
  productId           String                @db.Uuid
  quantity            Int
  type                InventoryMovementType
  reason              String?
  createdByUserId     String?               @db.Uuid
  transferId          String?               @db.Uuid

  createdAt DateTime @default(now())

  location      InventoryLocation  @relation(fields: [inventoryLocationId], references: [id], onDelete: Cascade)
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdByUser User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  transfer      InventoryTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@index([inventoryLocationId, createdAt])
  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([transferId])
  @@map("inventory_movements")
}

enum InventoryTransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model InventoryTransfer {
  id              String                  @id @default(uuid()) @db.Uuid
  number          String                  @unique
  fromLocationId  String                  @db.Uuid
  toLocationId    String                  @db.Uuid
  status          InventoryTransferStatus @default(PENDING)
  notes           String?
  createdByUserId String?                 @db.Uuid

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  fromLocation  InventoryLocation       @relation("TransferFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation    InventoryLocation       @relation("TransferToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  createdByUser User?                   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items         InventoryTransferItem[]
  movements     InventoryMovement[]

  @@index([status, createdAt])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id         String @id @default(uuid()) @db.Uuid
  transferId String @db.Uuid
  productId  String @db.Uuid
  quantity   Int

  createdAt DateTime @default(now())

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([transferId, productId])
  @@index([productId])
  @@map("inventory_transfer_items")
}

// ─────────────────────────────────────────────
// ECOMMERCE — ORDERS
// ─────────────────────────────────────────────

/// Ciclo de vida completo de un pedido ecommerce.
///   PENDING    → recién creado, esperando pago/confirmación.
///   PAID       → pago confirmado. Trigger único de side effects (stock,
///                membership, raffle entries, referral bonus).
///   PROCESSING → preparándose en almacén tras cobro.
///   SHIPPED    → entregado al courier.
///   DELIVERED  → recibido por el cliente. Estado funcional terminal del flujo feliz.
///   CANCELLED  → terminal desde PENDING únicamente. No emite side effects.
///   REFUNDED   → terminal alcanzable solo vía credit note. Revierte side effects
///                (smart revert de membership en pos-credit-notes.service).
/// Las transiciones válidas se documentan en orders/state-machine.ts y se validan
/// con assertValidOrderStatusTransition() en OrdersService.updateStatus().
enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderPaymentMethod {
  MERCADOPAGO
  YAPE
  CASH
  CARD
}

enum OrderChannel {
  ECOMMERCE
  POS
}

model Order {
  id                  String             @id @default(uuid()) @db.Uuid
  number              String             @unique
  userId              String?            @db.Uuid
  customerId          String?            @db.Uuid
  inventoryLocationId String?            @db.Uuid
  cashSessionId       String?            @db.Uuid
  channel             OrderChannel       @default(ECOMMERCE)
  /// Suma bruta de items (qty × unitPrice). En POS con descuento manual
  /// también es el bruto antes del descuento. En el sistema fiscal peruano
  /// los precios YA incluyen IGV, por lo que este valor es CON IGV.
  subtotal            Decimal            @db.Decimal(10, 2)
  discount            Decimal            @default(0) @db.Decimal(10, 2)
  /// Total final cobrado (subtotal - discount). Incluye IGV.
  total               Decimal            @db.Decimal(10, 2)
  /// Pago principal — para órdenes ecommerce simples. En POS con pago mixto
  /// se llena con el método de mayor monto y los detalles van en `payments[]`.
  paymentMethod       OrderPaymentMethod
  status              OrderStatus        @default(PENDING)
  notes               String?

  // ─── FISCAL ENGINE PERÚ ───────────────────────────────────────────────
  /// Si los precios almacenados (Product.price, OrderItem.unitPrice) ya
  /// incluyen IGV. Default true (estándar retail Perú).
  pricesIncludeIgv  Boolean @default(true)
  /// Tasa IGV aplicada (18.00 por defecto en Perú). Se persiste para no
  /// recalcular si cambia la tasa en el futuro.
  igvRate           Decimal @default(18.00) @db.Decimal(5, 2)
  /// Base imponible (subtotal SIN IGV) — para reportes SUNAT y XML UBL.
  /// = round2(total / (1 + igvRate/100))
  subtotalUntaxed   Decimal @default(0) @db.Decimal(10, 2)
  /// Monto de IGV contenido en el total. = round2(total - subtotalUntaxed)
  igvAmount         Decimal @default(0) @db.Decimal(10, 2)

  // ─── SUNAT-ready receipt + snapshot fiscal del cliente ────────────────
  receiptType     ReceiptSeriesType?
  receiptSeries   String?
  receiptNumber   Int?
  receiptIssuedAt DateTime?

  /// Snapshot fiscal del cliente al momento de la emisión. Se persiste
  /// independientemente del Customer para que el comprobante quede
  /// inmutable aunque el cliente se edite o elimine después.
  customerDocumentType   CustomerDocumentType?
  customerDocumentNumber String?
  customerLegalName      String?
  customerFiscalAddress  String?
  customerEmail          String?

  // ─── SUNAT submission (arquitectura preparada, integración futura) ───
  sunatStatus         SunatStatus @default(PENDING)
  sunatXml            String?     @db.Text
  sunatSignedXml      String?     @db.Text
  sunatHash           String?
  sunatCdr            String?     @db.Text
  sunatErrorCode      String?
  sunatErrorMessage   String?
  sunatSubmittedAt    DateTime?

  // ─── Shipping snapshot (FASE 2 / F2.6-A) ─────────────────────────────
  /// Snapshot inmutable de la dirección de entrega elegida en el checkout.
  /// Patrón espejo del snapshot fiscal: campos string denormalizados, NO FK,
  /// para que el pedido quede legible aunque el CustomerAddress se borre
  /// (soft delete). `shippingAddressId` es referencia débil para audit, no FK.
  shippingAddressId        String? @db.Uuid
  shippingRecipientName    String? @db.VarChar(120)
  shippingRecipientPhone   String? @db.VarChar(20)
  shippingStreet           String? @db.VarChar(200)
  shippingNumber           String? @db.VarChar(20)
  shippingApartment        String? @db.VarChar(60)
  shippingDistrict         String? @db.VarChar(80)
  shippingProvince         String? @db.VarChar(80)
  shippingRegion           String? @db.VarChar(80)
  shippingCountryCode      String? @db.Char(2)
  shippingReference        String? @db.VarChar(240)

  // ─── F2.8-A — Membership Benefits Engine idempotency ─────────────────
  /// Sello que indica que el Membership Engine ya aplicó los beneficios
  /// (activate/renew, tickets PURCHASE_REWARD, logs, sync Customer.isMember,
  /// referral bonus) para esta orden. CAS pattern:
  ///   UPDATE orders SET benefitsAppliedAt = now()
  ///   WHERE id = ? AND benefitsAppliedAt IS NULL
  /// Si count = 0, otra ejecución ya ganó el claim → NO-OP idempotente.
  /// NULL para órdenes que aún no llegaron a PAID (o pre-F2.8-A no backfilled).
  benefitsAppliedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer            Customer?              @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)
  location            InventoryLocation?     @relation(fields: [inventoryLocationId], references: [id], onDelete: SetNull)
  cashSession         POSCashSession?        @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            OrderPayment[]
  raffleEntries       RaffleEntry[]
  benefitLogs         MembershipBenefitLog[]
  cashMovements       POSCashMovement[]
  creditNotes         POSCreditNote[]        @relation("OrderCreditNotes")
  exchangeCreditNotes POSCreditNote[]        @relation("OrderExchangeCreditNotes")

  @@index([userId, status])
  @@index([customerId, status])
  @@index([inventoryLocationId, status])
  @@index([channel, status, createdAt])
  @@index([cashSessionId])
  @@index([status, createdAt])
  @@index([sunatStatus])
  @@index([receiptType, receiptSeries, receiptNumber])
  // F2.8-A — facilita el scan del reconciler futuro: órdenes PAID cuyo engine
  // no terminó (status=PAID AND benefitsAppliedAt IS NULL). El índice parcial
  // se materializa en la migración (Prisma todavía no expone índices parciales
  // en el DSL; usamos un índice ordinario que Postgres puede usar igualmente).
  @@index([status, benefitsAppliedAt])
  @@map("orders")
}

/// Pago individual de una orden. Para POS soporta pago mixto (efectivo + Yape, etc.).
/// Para ecommerce simple suele haber un solo registro espejo de `Order.paymentMethod`.
model OrderPayment {
  id        String             @id @default(uuid()) @db.Uuid
  orderId   String             @db.Uuid
  method    OrderPaymentMethod
  amount    Decimal            @db.Decimal(10, 2)
  reference String?
  createdAt DateTime           @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([method, createdAt])
  @@map("order_payments")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int
  /// Precio unitario CON IGV (lo que se muestra al cliente).
  unitPrice Decimal @db.Decimal(10, 2)
  /// quantity × unitPrice (CON IGV).
  subtotal  Decimal @db.Decimal(10, 2)

  // ─── Desglose IGV por línea (SUNAT XML UBL requiere este breakdown) ──
  /// Tasa IGV aplicada a esta línea (típicamente 18.00). Permite líneas
  /// exoneradas/inafectas en el futuro (0.00).
  igvRate          Decimal @default(18.00) @db.Decimal(5, 2)
  /// Precio unitario SIN IGV. = round2(unitPrice / (1 + igvRate/100))
  unitPriceUntaxed Decimal @default(0) @db.Decimal(10, 2)
  /// Subtotal SIN IGV. = round2(quantity × unitPriceUntaxed)
  subtotalUntaxed  Decimal @default(0) @db.Decimal(10, 2)
  /// IGV contenido en la línea. = round2(subtotal - subtotalUntaxed)
  igvAmount        Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  creditNoteItems POSCreditNoteItem[] @relation("OrderItemReturns")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─────────────────────────────────────────────
// PÚRPURA CLUB — MEMBERSHIP ENGINE
// ─────────────────────────────────────────────

model Membership {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  active         Boolean   @default(true)
  startedAt      DateTime  @default(now())
  expiresAt      DateTime
  lastPurchaseAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications MembershipNotificationLog[]

  @@index([active, expiresAt])
  @@index([expiresAt])
  @@map("memberships")
}

// F2.7-E — Tipos canónicos de notificaciones de ciclo de vida del Club.
// El scheduler dispara los REMINDER_*; `activateOrRenew` dispara WELCOME.
// Cualquier nuevo tipo debe agregarse aquí Y modelar su trigger en
// MembershipNotificationsService — la tabla es la fuente única de auditoría.
enum MembershipNotificationType {
  WELCOME
  REMINDER_7D
  REMINDER_3D
  REMINDER_1D
}

// F2.7-E — Audit + idempotencia de notificaciones por email del Club.
//
// Cada fila representa UN envío exitoso (o registrado como "claim" por una
// instancia del scheduler). El unique compuesto `(membershipId, type,
// referenceExpiresAt)` es la estrategia oficial de:
//
//   1. Idempotencia: el mismo membership no recibe dos veces el mismo type
//      para el mismo ciclo.
//   2. Lock distribuido: en cluster multi-instancia, el primer INSERT gana
//      y los demás reciben P2002 → skip silencioso.
//
// `referenceExpiresAt` se snapshotea desde `Membership.expiresAt` al
// momento del envío. Renovar la membresía cambia ese valor y libera la
// posibilidad de enviar el siguiente ciclo de reminders sin colisionar
// con los del ciclo anterior.
//
// `toEmail` también se snapshotea: si el usuario cambia su email después,
// la auditoría preserva la dirección a la que efectivamente se mandó.
model MembershipNotificationLog {
  id                 String                     @id @default(uuid()) @db.Uuid
  membershipId       String                     @db.Uuid
  userId             String                     @db.Uuid
  type               MembershipNotificationType

  /// expiresAt del ciclo al momento del envío. Cada renovación produce
  /// un valor distinto y por tanto puede emitir un nuevo set de reminders.
  referenceExpiresAt DateTime

  /// ID devuelto por el EmailProvider (Resend/SES/etc.) cuando está
  /// disponible. Permite trazar bounces y reintentos manuales. NULL si
  /// el provider no devolvió ID o el envío falló tras claim.
  emailMessageId     String?

  /// Email destinatario snapshot al momento del envío. Inmutable.
  toEmail            String

  sentAt             DateTime                   @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([membershipId, type, referenceExpiresAt], map: "uq_membership_notif_per_cycle")
  @@index([userId, type])
  @@index([sentAt])
  @@map("membership_notification_logs")
}

enum MembershipBenefitType {
  DISCOUNT
  RAFFLE_ENTRY
  REFERRAL_BONUS
}

model MembershipBenefitLog {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @db.Uuid
  orderId     String?               @db.Uuid
  type        MembershipBenefitType
  description String
  amount      Decimal?              @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([orderId])
  @@map("membership_benefit_logs")
}

model Referral {
  id             String    @id @default(uuid()) @db.Uuid
  referrerUserId String    @db.Uuid
  referredUserId String    @unique @db.Uuid
  rewarded       Boolean   @default(false)
  rewardedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrer User @relation("ReferralFrom", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralTo", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId, rewarded])
  @@map("referrals")
}

// ─────────────────────────────────────────────
// CRM — CUSTOMERS
// ─────────────────────────────────────────────
//
// Customer = perfil COMERCIAL del cliente (CRM).
// User     = identidad de AUTENTICACIÓN.
//
// Un Customer puede o no estar enlazado a un User:
//  - Cliente que se registró por ecommerce: tiene userId.
//  - Cliente walk-in creado desde POS: userId = null.
//  - El POS futuro podrá vincular un Customer existente a una cuenta User
//    en cualquier momento.
//
// Las estadísticas (totalSpent, lastPurchaseAt, etc.) se calculan en runtime
// agregando órdenes y participaciones — no se denormalizan para evitar drift.

enum CustomerGender {
  MASCULINO
  FEMENINO
  OTRO
}

/// Tipos de documento fiscal soportados (SUNAT Perú).
///  - DNI: persona natural peruana (8 dígitos). Asociado a BOLETA.
///  - RUC: persona jurídica o natural con negocio (11 dígitos). Requerido para FACTURA.
///  - CE: carnet de extranjería.
///  - PASSPORT: pasaporte (extranjeros).
enum CustomerDocumentType {
  DNI
  RUC
  CE
  PASSPORT
}

model Customer {
  id     String  @id @default(uuid()) @db.Uuid
  // Vínculo opcional con la cuenta de autenticación.
  userId String? @unique @db.Uuid

  firstName String
  lastName  String
  // fullName se mantiene denormalizado y se sincroniza en cada update — usado
  // para búsquedas insensibles a mayúsculas/acentos y ordenamiento alfabético.
  fullName  String

  email String?
  phone String?
  dni   String? @unique

  // ─── Datos fiscales (SUNAT-ready) ─────────────────────────────────────
  /// Tipo de documento fiscal. Por defecto DNI (persona natural).
  documentType   CustomerDocumentType @default(DNI)
  /// RUC (11 dígitos). Si está presente el cliente puede recibir factura.
  /// Único globalmente cuando se llena.
  ruc            String?              @unique
  /// Razón social (para facturas). En personas naturales = nombre legal.
  legalName      String?
  /// Dirección fiscal (requerida para facturas SUNAT).
  fiscalAddress  String?

  birthDate DateTime?
  gender    CustomerGender?

  notes String? @db.Text

  // Membresía denormalizada para el POS / búsqueda rápida.
  // La fuente de verdad sigue siendo el modelo Membership cuando hay userId.
  isMember            Boolean   @default(false)
  membershipExpiresAt DateTime?

  active Boolean @default(true)

  // Sucursal de captación (POS). Null = ecommerce o sin asignar.
  primaryLocationId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User?              @relation("UserCustomerProfile", fields: [userId], references: [id], onDelete: SetNull)
  primaryLocation InventoryLocation? @relation("CustomerPrimaryLocation", fields: [primaryLocationId], references: [id], onDelete: SetNull)

  orders    Order[]           @relation("CustomerOrders")
  addresses CustomerAddress[] @relation("CustomerAddresses")

  @@index([active])
  @@index([isMember, active])
  @@index([primaryLocationId, active])
  @@index([fullName])
  @@index([phone])
  @@index([email])
  @@index([documentType, ruc])
  @@map("customers")
}

// ─────────────────────────────────────────────
// CUSTOMER ADDRESSES — FASE 2 / F2.5
// ─────────────────────────────────────────────

/// Tipo semántico de dirección registrada por el cliente.
///   SHIPPING  → dirección de entrega ecommerce (UI activa en F2.5).
///   BILLING   → facturación alternativa (puede divergir de Customer.fiscalAddress).
///   PICKUP    → punto de retiro en tienda / POS (reservado para FASE futura).
///
/// IMPORTANTE: este modelo NO reemplaza Customer.fiscalAddress (string
/// denormalizado para SUNAT) ni Order.customerFiscalAddress (snapshot
/// inmutable del comprobante). Ambos permanecen intactos para preservar
/// la inmutabilidad legal del comprobante fiscal SUNAT.
enum AddressType {
  SHIPPING
  BILLING
  PICKUP
}

model CustomerAddress {
  id         String      @id @default(uuid()) @db.Uuid
  customerId String      @db.Uuid

  type  AddressType @default(SHIPPING)
  label String?     @db.VarChar(60)

  /// Datos del receptor — pueden diferir del Customer (p.ej. envío a un familiar).
  recipientName  String @db.VarChar(120)
  recipientPhone String @db.VarChar(20)

  /// Componentes geográficos (Perú-first, free-form en region/province/district
  /// para no rigidizar antes de tener UBIGEO completo).
  street      String  @db.VarChar(200)
  number      String  @db.VarChar(20)
  apartment   String? @db.VarChar(60)
  district    String  @db.VarChar(80)
  province    String  @db.VarChar(80)
  region      String  @db.VarChar(80)
  countryCode String  @default("PE") @db.Char(2)
  reference   String? @db.VarChar(240)

  /// Exactamente una isDefault=true por (customerId, type) activa. Enforced
  /// por CustomerAddressesService en transacción atómica.
  isDefault Boolean @default(false)

  /// Soft delete para no romper referencias históricas si en el futuro Order
  /// referencia direcciones. Listados públicos filtran active=true.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation("CustomerAddresses", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type, active])
  @@index([customerId, isDefault])
  @@map("customer_addresses")
}

// ─────────────────────────────────────────────
// POS ENGINE — Cajas, sesiones, movimientos, series de comprobantes
// ─────────────────────────────────────────────

/// Caja física de un POS. Cada InventoryLocation tiene una caja principal
/// auto-creada en su `create()`. Las locations pueden tener N cajas.
model POSCashRegister {
  id                  String  @id @default(uuid()) @db.Uuid
  inventoryLocationId String  @db.Uuid
  name                String
  active              Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location InventoryLocation @relation("LocationCashRegisters", fields: [inventoryLocationId], references: [id], onDelete: Cascade)
  sessions POSCashSession[]

  @@unique([inventoryLocationId, name])
  @@index([inventoryLocationId, active])
  @@map("pos_cash_registers")
}

enum POSCashSessionStatus {
  OPEN
  CLOSED
}

/// Sesión de caja del turno. Una sola sesión OPEN por caja a la vez.
model POSCashSession {
  id               String               @id @default(uuid()) @db.Uuid
  cashRegisterId   String               @db.Uuid
  openedByUserId   String               @db.Uuid
  closedByUserId   String?              @db.Uuid
  openingAmount    Decimal              @db.Decimal(10, 2)
  /// Efectivo declarado al cerrar (lo que el cajero contó).
  closingAmount    Decimal?             @db.Decimal(10, 2)
  /// Efectivo esperado = apertura + ingresos efectivo - egresos efectivo + ventas efectivo.
  expectedAmount   Decimal?             @db.Decimal(10, 2)
  /// closingAmount - expectedAmount (positivo = sobrante, negativo = faltante).
  differenceAmount Decimal?             @db.Decimal(10, 2)
  status           POSCashSessionStatus @default(OPEN)
  openedAt         DateTime             @default(now())
  closedAt         DateTime?
  notes            String?

  cashRegister POSCashRegister   @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  openedBy     User              @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedBy     User?             @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  movements    POSCashMovement[]
  orders       Order[]
  creditNotes  POSCreditNote[]   @relation("CashSessionCreditNotes")

  @@index([cashRegisterId, status])
  @@index([status, openedAt])
  @@map("pos_cash_sessions")
}

enum POSCashMovementType {
  OPENING
  SALE
  INCOME
  EXPENSE
  CLOSING
}

/// Movimiento auditado de la caja. Cubre apertura, ventas, ingresos manuales
/// (cambio adicional, ajustes), egresos (movilidad, limpieza, retiro), cierre
/// y devoluciones (REFUND, salida de efectivo por nota de crédito).
model POSCashMovement {
  id              String              @id @default(uuid()) @db.Uuid
  sessionId       String              @db.Uuid
  type            POSCashMovementType
  amount          Decimal             @db.Decimal(10, 2)
  reason          String?
  notes           String?
  orderId         String?             @db.Uuid
  /// Si el movimiento proviene de una nota de crédito (devolución/cambio/anulación).
  creditNoteId    String?             @db.Uuid
  createdByUserId String?             @db.Uuid

  createdAt DateTime @default(now())

  session    POSCashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  order      Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  creditNote POSCreditNote? @relation("CreditNoteCashMovements", fields: [creditNoteId], references: [id], onDelete: SetNull)
  createdBy  User?          @relation("CashMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([type, createdAt])
  @@index([orderId])
  @@index([creditNoteId])
  @@map("pos_cash_movements")
}

enum ReceiptSeriesType {
  BOLETA
  FACTURA
  /// Nota de crédito electrónica (NCR-E SUNAT). Se asocia a un comprobante
  /// original (BOLETA o FACTURA) para devoluciones, anulaciones o cambios.
  NOTA_CREDITO
  /// Nota de débito electrónica (NDE-E SUNAT). Para ajustes posteriores
  /// (intereses, cargos adicionales). Arquitectura preparada, sin uso aún.
  NOTA_DEBITO
  /// Comprobante interno NO-SUNAT — usado solo en flujos legacy.
  NOTA_VENTA
}

/// Estado del envío del comprobante a SUNAT. Arquitectura preparada;
/// la integración real (firma XML, envío al PSE/OSE, recepción CDR) se
/// implementa en un sprint posterior.
enum SunatStatus {
  /// Comprobante emitido localmente, aún no enviado a SUNAT.
  PENDING
  /// Enviado a SUNAT/PSE, esperando CDR.
  SUBMITTED
  /// Aceptado por SUNAT (CDR recibido con código 0).
  ACCEPTED
  /// Aceptado con observaciones (CDR con código 100-999).
  OBSERVED
  /// Rechazado por SUNAT (CDR con código ≥ 2000 o error de envío).
  REJECTED
  /// El comprobante fue anulado mediante comunicación de baja.
  CANCELLED
}

/// Serie de comprobantes asignada a una sucursal (o al ecommerce si
/// `inventoryLocationId` es null). Soporta numeración SUNAT-ready con
/// `nextNumber` incrementado atómicamente al emitir.
model ReceiptSeries {
  id                  String            @id @default(uuid()) @db.Uuid
  inventoryLocationId String?           @db.Uuid
  type                ReceiptSeriesType
  series              String
  nextNumber          Int               @default(1)
  active              Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location InventoryLocation? @relation("LocationReceiptSeries", fields: [inventoryLocationId], references: [id], onDelete: Cascade)

  @@unique([series, type])
  @@index([inventoryLocationId, type, active])
  @@map("receipt_series")
}

// ─────────────────────────────────────────────
// POS — NOTAS DE CRÉDITO / DEVOLUCIONES / ANULACIONES
// ─────────────────────────────────────────────
//
// POSCreditNote = comprobante interno (futuro SUNAT NCR-E) que documenta una
// devolución total, parcial, cambio de producto o anulación de venta.
//
// Cada NC:
//   - Revierte stock atómicamente con CAS sobre `InventoryStock` y crea
//     `InventoryMovement.RESTOCK`.
//   - Registra `POSCashMovement.REFUND` con `creditNoteId` para impactar caja.
//   - Para FULL_RETURN / SALE_CANCELLATION marca la orden original como
//     `REFUNDED` y libera tickets de raffle + (smart-auto) revierte membresía
//     solo si era la única compra calificada del cliente.
//   - Para PRODUCT_EXCHANGE, opcionalmente enlaza con una nueva orden
//     (`exchangeOrderId`) creada en el mismo flujo.

enum POSCreditNoteType {
  FULL_RETURN
  PARTIAL_RETURN
  PRODUCT_EXCHANGE
  SALE_CANCELLATION
}

model POSCreditNote {
  id                  String  @id @default(uuid()) @db.Uuid
  /// Número interno NC-XXXXXXXX. Único global.
  number              String  @unique
  orderId             String  @db.Uuid
  /// Si la nota es un PRODUCT_EXCHANGE, esta es la nueva orden generada.
  exchangeOrderId     String? @db.Uuid
  inventoryLocationId String  @db.Uuid
  /// Sesión de caja donde se procesa (opcional para casos administrativos).
  cashSessionId       String? @db.Uuid
  createdByUserId     String  @db.Uuid

  type   POSCreditNoteType
  reason String
  notes  String?           @db.Text

  /// Monto total devuelto (suma de items.subtotal CON IGV). En
  /// SALE_CANCELLATION coincide con order.total.
  subtotal     Decimal @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)
  /// Efectivo realmente entregado al cliente. En EXCHANGE puede ser 0 o la diferencia.
  refundedCash Decimal @default(0) @db.Decimal(10, 2)

  // ─── FISCAL ENGINE (espejo de Order) ─────────────────────────────────
  pricesIncludeIgv  Boolean @default(true)
  igvRate           Decimal @default(18.00) @db.Decimal(5, 2)
  subtotalUntaxed   Decimal @default(0) @db.Decimal(10, 2)
  igvAmount         Decimal @default(0) @db.Decimal(10, 2)

  // ─── SUNAT-ready (integración futura) ────────────────────────────────
  /// Tipo del comprobante NC. Típicamente NOTA_CREDITO. Se asigna al emitir.
  receiptType     ReceiptSeriesType?
  receiptSeries   String?
  receiptNumber   Int?
  receiptIssuedAt DateTime?

  /// Snapshot fiscal del cliente (copia de la orden original al momento NC).
  customerDocumentType   CustomerDocumentType?
  customerDocumentNumber String?
  customerLegalName      String?
  customerFiscalAddress  String?
  customerEmail          String?

  /// SUNAT submission state (igual que Order).
  sunatStatus       SunatStatus @default(PENDING)
  sunatXml          String?     @db.Text
  sunatSignedXml    String?     @db.Text
  sunatHash         String?
  sunatCdr          String?     @db.Text
  sunatErrorCode    String?
  sunatErrorMessage String?
  sunatSubmittedAt  DateTime?

  createdAt DateTime @default(now())

  order         Order               @relation("OrderCreditNotes", fields: [orderId], references: [id], onDelete: Restrict)
  exchangeOrder Order?              @relation("OrderExchangeCreditNotes", fields: [exchangeOrderId], references: [id], onDelete: SetNull)
  location      InventoryLocation   @relation("LocationCreditNotes", fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  cashSession   POSCashSession?     @relation("CashSessionCreditNotes", fields: [cashSessionId], references: [id], onDelete: SetNull)
  createdBy     User                @relation("CreditNoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items         POSCreditNoteItem[]
  cashMovements POSCashMovement[]   @relation("CreditNoteCashMovements")

  @@index([orderId])
  @@index([exchangeOrderId])
  @@index([inventoryLocationId, createdAt])
  @@index([cashSessionId])
  @@index([type, createdAt])
  @@index([sunatStatus])
  @@index([receiptType, receiptSeries, receiptNumber])
  @@map("pos_credit_notes")
}

model POSCreditNoteItem {
  id           String  @id @default(uuid()) @db.Uuid
  creditNoteId String  @db.Uuid
  /// Item original devuelto (puede ser null si se importó manualmente).
  orderItemId  String? @db.Uuid
  productId    String  @db.Uuid
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  subtotal     Decimal @db.Decimal(10, 2)

  // ─── Desglose IGV por línea (espejo de OrderItem) ───────────────────
  igvRate          Decimal @default(18.00) @db.Decimal(5, 2)
  unitPriceUntaxed Decimal @default(0) @db.Decimal(10, 2)
  subtotalUntaxed  Decimal @default(0) @db.Decimal(10, 2)
  igvAmount        Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  creditNote POSCreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  orderItem  OrderItem?    @relation("OrderItemReturns", fields: [orderItemId], references: [id], onDelete: SetNull)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([creditNoteId])
  @@index([productId])
  @@index([orderItemId])
  @@map("pos_credit_note_items")
}

// ─────────────────────────────────────────────
// HOME BANNERS — CMS editorial (storefront)
// ─────────────────────────────────────────────
//
// 4 slots fijos para el hero del home (stack vertical editorial):
//   JEWELRY, PERFUME, RAFFLE, FLEXIBLE.
// Cada slot es único y editable desde el panel SUPERADMIN. El slot FLEXIBLE
// puede desactivarse (active=false) para ocultar la franja en el storefront.
//
// Las imágenes son URLs públicas (HTTPS) administradas externamente — el repo
// no incluye sistema de upload, mismo patrón que productos y rifas. Se separan
// imagen desktop (cinematográfica horizontal) e imagen mobile (crop vertical
// optimizado) para evitar recortes pobres en mobile.

enum HomeBannerSlot {
  JEWELRY
  PERFUME
  RAFFLE
  FLEXIBLE
}

enum HomeBannerAlign {
  LEFT
  CENTER
  RIGHT
}

// ─────────────────────────────────────────────
// HOME CATEGORIES — Carrusel editorial (storefront)
// ─────────────────────────────────────────────
//
// 3 slots fijos para el "category showcase" del home (carrusel horizontal):
//   JEWELRY, PERFUME, RAFFLE.
//
// Cada slot vive aparte del modelo `Category` del catálogo porque:
//   1. RAFFLE no es una categoría de producto (apunta a /sorteos).
//   2. La presentación editorial del home tiene sus propias imágenes y
//      overlays, independientes del catálogo.
//   3. Permite editar el showcase sin alterar la taxonomía de productos.

enum HomeCategorySlot {
  PERFUMES_HOMBRE
  PERFUMES_MUJER
  JOYAS_ACERO_DORADO
  JOYAS_ACERO_PLATEADO
  JOYAS_BANADAS_ORO
  JOYAS_PLATA
}

model HomeCategory {
  id     String           @id @default(uuid()) @db.Uuid
  /// Slot fijo del showcase. Único — solo existe una card por slot.
  slot   HomeCategorySlot @unique
  /// Orden de aparición en el carrusel (ASC). Por defecto refleja el orden
  /// semántico: JEWELRY=1, PERFUME=2, RAFFLE=3.
  sortOrder Int           @default(0)
  /// Si false, la card se oculta del storefront sin borrar la config.
  active    Boolean       @default(true)

  /// Micro-etiqueta superior (uppercase tracking). Ej. "Joyería".
  eyebrow  String?
  /// Nombre principal mostrado en la card. Ej. "Joyas".
  label    String
  /// Destino del CTA (path relativo o URL absoluta).
  ctaHref  String

  /// URL de la imagen para desktop (composición horizontal/cuadrada).
  imageDesktop String?
  /// URL de la imagen para mobile (crop vertical).
  imageMobile  String?

  /// Color del overlay sobre la imagen (HEX, ej. "#0A0A0A").
  overlayColor   String @default("#0A0A0A")
  /// Opacidad del overlay (0-100). Mayor = más oscuro = mejor legibilidad.
  overlayOpacity Int    @default(35)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("home_categories")
}

// ─────────────────────────────────────────────
// HOME STORES — Boutique showcase (storefront)
// ─────────────────────────────────────────────
//
// CRUD ilimitado de tiendas físicas que se muestran en el carrusel del home.
// Separado del modelo operacional `InventoryLocation` porque:
//   1. La presentación editorial del home tiene campos específicos
//      (imageDesktop, imageMobile, mapsUrl, schedule, whatsapp) que no
//      pertenecen al dominio POS/inventario.
//   2. Permite tener boutiques temporales / showrooms en el home que NO
//      son ubicaciones de inventario.
//   3. Da control editorial total (orden, activación, edición) sin riesgo
//      de afectar stock o POS.

model HomeStore {
  id           String   @id @default(uuid()) @db.Uuid
  /// Nombre comercial. Ej. "Plaza del Sol — Ica".
  name         String
  /// Ciudad — mostrada arriba del nombre como eyebrow.
  city         String
  /// Dirección postal completa.
  address      String
  /// Referencia opcional ("Frente al parque central").
  reference    String?
  /// Número de WhatsApp (con código país, ej. +51999111222).
  whatsapp     String?
  /// Horario de atención libre ("Lun a sáb · 10:00 – 22:00").
  schedule     String?
  /// URL de Google Maps para el botón "Cómo llegar".
  mapsUrl      String?
  /// URL HTTPS de la imagen para desktop (composición horizontal o cuadrada).
  imageDesktop String?
  /// URL HTTPS de la imagen para mobile (crop vertical).
  imageMobile  String?
  /// Orden de aparición en el carrusel (ASC).
  sortOrder    Int      @default(0)
  /// Si false, la tienda se oculta del storefront sin borrar la config.
  active       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("home_stores")
}

model HomeBanner {
  id     String          @id @default(uuid()) @db.Uuid
  /// Slot fijo del home. Único — solo existe un banner por slot.
  slot   HomeBannerSlot  @unique
  /// Orden de aparición en el stack vertical (ASC). Por defecto refleja el
  /// orden semántico: JEWELRY=1, PERFUME=2, RAFFLE=3, FLEXIBLE=4.
  order  Int             @default(0)
  active Boolean         @default(true)

  /// Pre-título corto (uppercase tracking). Ej. "Joyería atemporal".
  eyebrow  String?
  /// Título principal (font-serif). Ej. "El detalle que distingue".
  title    String
  /// Subcopy descriptiva. Opcional.
  subtitle String?

  /// Texto del CTA. Ej. "Ver productos", "Ir a sorteos".
  ctaLabel String
  /// Destino del CTA (path relativo o URL absoluta).
  ctaHref  String

  /// URL de la imagen para desktop (composición horizontal).
  imageDesktop String?
  /// URL de la imagen para mobile (composición vertical).
  imageMobile  String?

  /// Color del overlay sobre la imagen (HEX, ej. "#0A0A0A").
  overlayColor   String          @default("#0A0A0A")
  /// Opacidad del overlay (0-100). Permite balancear legibilidad vs imagen.
  overlayOpacity Int             @default(40)
  /// Alineación del bloque de texto sobre el banner.
  align          HomeBannerAlign @default(LEFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
  @@map("home_banners")
}

// ─────────────────────────────────────────────
// LIBRO DE RECLAMACIONES (Peru INDECOPI)
// ─────────────────────────────────────────────
// Registro digital del Libro de Reclamaciones requerido por el Código de
// Protección y Defensa del Consumidor (Ley 29571 / D.S. 011-2011-PCM).
// Cada submission queda inmutable en su payload original; el admin solo
// gestiona el estado y la respuesta oficial.

enum ComplaintType {
  /// Reclamo: disconformidad con un producto/servicio recibido.
  RECLAMO
  /// Queja: malestar respecto a la atención al consumidor.
  QUEJA
}

enum ComplaintSubjectType {
  PRODUCTO
  SERVICIO
}

enum ComplaintStatus {
  /// Recién recibido, pendiente de asignación.
  PENDIENTE
  /// En revisión por un agente. Tiene 30 días calendario por norma.
  EN_REVISION
  /// Resuelto con respuesta enviada al consumidor.
  RESUELTO
}

enum ComplaintDocumentType {
  DNI
  CE
  PASSPORT
  RUC
}

model Complaint {
  id String @id @default(uuid()) @db.Uuid

  /// Folio público correlativo amigable al usuario. Se imprime en el
  /// acuse, se usa en comunicaciones con el consumidor. Único.
  /// Formato sugerido: "LR-YYYY-NNNNNN" (LR = Libro de Reclamaciones).
  /// Generado por el service en una transacción para evitar carreras.
  ticketNumber String @unique

  // ─── Consumidor ─────────────────────────────────
  firstName    String
  lastName     String
  documentType ComplaintDocumentType @default(DNI)
  documentNumber String
  phone        String
  email        String
  address      String

  // Solo si el consumidor es menor de edad — campos del padre/madre o tutor.
  /// true cuando el consumidor declara ser menor de edad. Si es true,
  /// `guardianFullName` y `guardianDocument` son requeridos por el service.
  isMinor          Boolean @default(false)
  guardianFullName String?
  guardianDocument String?

  // ─── Detalle del reclamo ────────────────────────
  type           ComplaintType
  subjectType    ComplaintSubjectType
  /// Descripción del producto/servicio adquirido.
  subjectDetail  String
  /// Monto reclamado en soles (decimal). Opcional.
  amount         Decimal? @db.Decimal(12, 2)
  /// Detalle completo del reclamo (texto libre).
  description    String
  /// Pedido específico del consumidor — qué solución espera.
  consumerRequest String

  // ─── Estado interno ─────────────────────────────
  status     ComplaintStatus @default(PENDIENTE)
  /// Respuesta oficial enviada al consumidor (si aplica).
  response   String?
  /// Notas internas — no se comparten con el consumidor.
  internalNotes String?
  /// Cuándo el reclamo cambió a RESUELTO.
  resolvedAt DateTime?
  /// Quién resolvió el reclamo (admin user). SetNull si el user se borra.
  resolvedByUserId String? @db.Uuid

  // ─── Trazabilidad ───────────────────────────────
  /// IP del consumidor al momento de la presentación. Útil para auditoría.
  submittedIp String?
  /// User-Agent del navegador al momento de la presentación.
  submittedUserAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([documentNumber])
  @@index([email])
  @@map("complaints")
}

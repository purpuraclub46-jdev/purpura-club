# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# CORS — comma-separated list of allowed origins, or "*"
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Swagger
SWAGGER_PATH=docs
SWAGGER_TITLE=Purpura Club API
SWAGGER_DESCRIPTION=Purpura Club REST API documentation
SWAGGER_VERSION=1.0.0

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Authentication — generate strong secrets (>=32 chars), e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace-me-with-a-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-me-with-a-different-secret-of-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=purpura-club
JWT_AUDIENCE=purpura-club-clients
BCRYPT_SALT_ROUNDS=12

# Refresh-token cookie
REFRESH_COOKIE_NAME=purpura_refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_PATH=/api
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=example.com
